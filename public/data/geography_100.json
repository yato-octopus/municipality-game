169.64],"wiki":"https://ja.wikipedia.org/wiki/%E9%98%BF%E5%AF%92%E6%B9%96","desc":"特別天然記念物のマリモが生息する。冬は全面結氷し、ワカサギ釣り、スケート、スノーモービルなどのウィンタースポーツがさかん"},{"id":"geo_018","name":"サロマ湖","ruby":"さろまこ","category":"lake","geometryType":"polygon","pts":[[733.88,131.84],[690.1,115.31],[700.5,136.73],[720.08,143.41],[742.71,137.85]],"center":[717.45,133.03],"wiki":"https://ja.wikipedia.org/wiki/%E3%82%B5%E3%83%AD%E3%83%9E%E6%B9%96","desc":"北海道内で最も大きな湖であり、日本で3番目に大きい。ホタテガイ、カキの養殖が盛ん"},{"id":"geo_019","name":"日和山","ruby":"ひよりやま","category":"mountain","geometryType":"polygon","pts":[[597.65,433.76],[579.82,464.39],[615.12,464.37]],"center":[597.53,454.17],"wiki":"https://ja.wikipedia.org/wiki/%E6%97%A5%E5%92%8C%E5%B1%B1_(%E4%BB%99%E5%8F%B0%E5%B8%82)","desc":"日本一低い山。かつては標高6mだったが、東日本大震災で消滅したと報道された。のちの調査により3mの山として認定された"},{"id":"geo_020","name":"中海","ruby":"なかうみ","category":"lake","geometryType":"polygon","pts":[[271.9,587.72],[258.38,587.97],[259.61,607.38],[275.28,607.34]],"center":[266.29,597.6],"wiki":"https://ja.wikipedia.org/wiki/%E4%B8%AD%E6%B5%B7","desc":"日本海に開いた湾の入り口が、砂州によって塞がれてできた。淡水性と海水性の両生物が生育・生息することができる地域である"},{"id":"geo_021","name":"琵琶湖","ruby":"びわこ","category":"lake","geometryType":"polygon","pts":[[414.61,605.14],[415.42,594.92],[408.14,589.19],[405.3,574.03],[399.86,575.76],[397.81,588.17],[392.09,587.47],[389.95,579.12],[380.96,590.44],[375.33,616.86],[366.03,625.74],[365.76,640.91],[362.28,656.54],[370.72,655.72],[374.72,642.46],[395.78,633.15],[402.7,620.56]],"center":[389.26,610.36],"wiki":"https://ja.wikipedia.org/wiki/%E7%90%B5%E7%90%B6%E6%B9%96","desc":"日本で最大の面積と貯水量を持つ世界で20しかない古代湖のひとつ"},{"id":"geo_022","name":"大雪山","ruby":"だいせつざん","category":"mountain","geometryType":"polygon","pts":[[677.78,134.23],[659.95,164.86],[695.25,164.85]],"center":[677.66,154.65],"wiki":"https://ja.wikipedia.org/wiki/%E5%A4%A7%E9%9B%AA%E5%B1%B1","desc":"北海道中央部にそびえる火山群の名称。一つの山ではないことを明確にするため、「ーー山系」という呼称も使われる"},{"id":"geo_023","name":"桜島","ruby":"さくらじま","category":"mountain","geometryType":"polygon","pts":[[162.9,774.78],[145.07,805.4],[180.37,805.39]],"center":[162.78,795.19],"wiki":"https://ja.wikipedia.org/wiki/%E6%A1%9C%E5%B3%B6","desc":"かつては島であったが、1914年の噴火により、鹿児島市の対岸の大隅半島と陸続きとなった"},{"id":"geo_024","name":"能取湖","ruby":"のとろこ","category":"lake","geometryType":"polygon","pts":[[727.28,132.44],[721.34,139.34],[722.92,147.16],[729.17,147.12],[736.37,140.68],[736.48,128.45]],"center":[728.93,139.2],"wiki":"https://ja.wikipedia.org/wiki/%E8%83%BD%E5%8F%96%E6%B9%96","desc":"湖畔にはアッケシソウ（サンゴ草）の群生地があり、毎年9月頃になると一面が赤色で埋め尽くされる"},{"id":"geo_025","name":"男体山","ruby":"なんたいさん","category":"mountain","geometryType":"polygon","pts":[[536.28,516.24],[518.45,546.87],[553.75,546.85]],"center":[536.16,536.65],"wiki":"https://ja.wikipedia.org/wiki/%E7%94%B7%E4%BD%93%E5%B1%B1","desc":"対の山として女峰山がある。女峰山、大真名子山、小真名子山、太郎山と火山一家を成しているところが特徴的"},{"id":"geo_026","name":"田沢湖","ruby":"たざわこ","category":"lake","geometryType":"polygon","pts":[[586.14,369.3],[575.34,369.59],[575.13,380.16],[584.41,381.57]],"center":[580.25,375.15],"wiki":"https://ja.wikipedia.org/wiki/%E7%94%B0%E6%B2%A2%E6%B9%96","desc":"日本で最も深い湖。423.4m。成因には隕石クレーター説なども検討されたが、爆発的噴火によるカルデラとの説が有力である"},{"id":"geo_027","name":"剣山","ruby":"つるぎさん","category":"mountain","geometryType":"polygon","pts":[[308.39,661.93],[290.56,692.56],[325.86,692.54]],"center":[308.27,682.34],"wiki":"https://ja.wikipedia.org/wiki/%E5%89%A3%E5%B1%B1","desc":"徳島県を中心に「けんざん」と呼ぶ人が多かった。徳島県が「つるぎさん」と決めて公式には統一された"},{"id":"geo_028","name":"大山","ruby":"だいせん","category":"mountain","geometryType":"polygon","pts":[[285.09,584.14],[267.26,614.77],[302.56,614.76]],"center":[284.97,604.56],"wiki":"https://ja.wikipedia.org/wiki/%E5%A4%A7%E5%B1%B1_(%E9%B3%A5%E5%8F%96%E7%9C%8C)","desc":"中国地方で一番高い。伯耆富士や出雲富士とも呼ばれ、鳥取県のシンボルの一つとされている"},{"id":"geo_029","name":"朱鞠内湖","ruby":"しゅまりないこ","category":"lake","geometryType":"polygon","pts":[[643.14,117.94],[643.3,126.6],[640.43,134.91],[646.68,134.88],[651.51,130.28],[652.5,118.18]],"center":[646.26,127.13],"wiki":"https://ja.wikipedia.o